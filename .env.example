# Product-layer bridge to the AWKN platform.
# This repository does not implement Agent OS / Engine / Memory OS / MCP internals.

# Chat task bridge used by assistant-ui.
AWKN_MARKETING_AGENT_URL=
AWKN_MARKETING_AGENT_TOKEN=

# General marketing product contract: Workspace / Material / Task / Outcome / Evolution / Learning.
AWKN_MARKETING_API_URL=
AWKN_MARKETING_API_TOKEN=

# Binary material upload + parse adapter. Receives multipart/form-data from /api/material-upload.
AWKN_MARKETING_MATERIAL_UPLOAD_URL=
AWKN_MARKETING_MATERIAL_UPLOAD_TOKEN=
AWKN_MARKETING_MATERIAL_MAX_MB=100
